{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PanYa",
  "version": "0.1.0",
  "identifier": "PanYa",
  "build": {
    "beforeDevCommand": {
      "script": "trunk serve frontend/index.html --port 1420",
      "cwd": "."
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "trunk build frontend/index.html --release",
      "cwd": "."
    },
    "frontendDist": "frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PanYa - ติดตามแผนจัดซื้อยา",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
